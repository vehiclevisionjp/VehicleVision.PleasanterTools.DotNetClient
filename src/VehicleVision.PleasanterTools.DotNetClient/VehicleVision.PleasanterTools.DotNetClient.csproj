<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>VehicleVision.PleasanterTools.DotNetClient</PackageId>
    <Description>Pleasanter の標準 Web API を呼ぶ .NET 向けクライアントライブラリ。</Description>
    <PackageTags>pleasanter;vehiclevision;api;client;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ライセンス関連の文書をパッケージの直下へ同梱する（PackageLicenseFile は LICENSING.md。Directory.Build.props 参照） -->
  <ItemGroup>
    <None Include="../../LICENSING.md;../../LICENSE-COMMERCIAL.md;../../LICENSE;../../COPYING;../../LICENSE-AGPL;../../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VehicleVision.PleasanterTools.DotNetClient.Tests" />
  </ItemGroup>

</Project>
